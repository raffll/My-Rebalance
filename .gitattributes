# This project standardizes on Windows (CRLF) line endings for all text files.
# tes3conv emits CRLF when generating JSON from ESPs, and the README generators
# write CRLF, so pinning CRLF keeps the working tree and repo consistent and
# stops the editor "LF vs CRLF" conversion warning.
* text=auto eol=crlf

# ESP plugins are binary — never normalize or convert them.
*.esp binary
*.esm binary
